{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "auth-users":            { "ClusterId": "auth",         "Match": { "Path": "/api/v1/users/{**rest}" } },
      "auth-users-root":       { "ClusterId": "auth",         "Match": { "Path": "/api/v1/users" } },
      "auth-sessions":         { "ClusterId": "auth",         "Match": { "Path": "/api/v1/sessions/{**rest}" } },
      "auth-sessions-root":    { "ClusterId": "auth",         "Match": { "Path": "/api/v1/sessions" } },

      "workspace-root":        { "ClusterId": "workspace",    "Match": { "Path": "/api/v1/workspaces" } },
      "workspace-any":         { "ClusterId": "workspace",    "Match": { "Path": "/api/v1/workspaces/{**rest}" } },
      "workspace-channels":    { "ClusterId": "workspace",    "Match": { "Path": "/api/v1/channels/{**rest}" } },
      "workspace-invitations": { "ClusterId": "workspace",    "Match": { "Path": "/api/v1/invitations/{**rest}" } },
      "workspace-invit-root":  { "ClusterId": "workspace",    "Match": { "Path": "/api/v1/invitations" } },

      "messaging-ws-convs":    { "ClusterId": "messaging",    "Match": { "Path": "/api/v1/workspaces/{workspaceId}/conversations" } },
      "messaging-convs":       { "ClusterId": "messaging",    "Match": { "Path": "/api/v1/conversations/{**rest}" } },
      "messaging-messages":    { "ClusterId": "messaging",    "Match": { "Path": "/api/v1/messages/{**rest}" } },
      "messaging-socket":      { "ClusterId": "messaging",    "Match": { "Path": "/api/v1/ws" } },

      "presence":              { "ClusterId": "presence",     "Match": { "Path": "/api/v1/workspaces/{workspaceId}/presence" } },
      "search":                { "ClusterId": "search",       "Match": { "Path": "/api/v1/workspaces/{workspaceId}/search/{**rest}" } },
      "notifications-root":    { "ClusterId": "notification", "Match": { "Path": "/api/v1/notifications" } },
      "notifications":         { "ClusterId": "notification", "Match": { "Path": "/api/v1/notifications/{**rest}" } }
    },
    "Clusters": {
      "auth":         { "Destinations": { "d1": { "Address": "http://auth:8080" } } },
      "workspace":    { "Destinations": { "d1": { "Address": "http://workspace:8080" } } },
      "messaging": {
        "LoadBalancingPolicy": "RoundRobin",
        "HealthCheck": {
          "Active": { "Enabled": true, "Interval": "00:00:05", "Timeout": "00:00:02", "Policy": "ConsecutiveFailures", "Path": "/health/ready" }
        },
        "Destinations": {
          "messaging-1": { "Address": "http://messaging-1:8080" },
          "messaging-2": { "Address": "http://messaging-2:8080" }
        }
      },
      "presence":     { "Destinations": { "d1": { "Address": "http://presence:8080" } } },
      "search":       { "Destinations": { "d1": { "Address": "http://search:8080" } } },
      "notification": { "Destinations": { "d1": { "Address": "http://notification:8080" } } }
    }
  }
}
