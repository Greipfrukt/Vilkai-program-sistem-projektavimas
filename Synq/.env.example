# Nukopijuoti į .env:  cp .env.example .env
# Visos reikšmės – tik lokaliam paleidimui.

POSTGRES_USER=synq
POSTGRES_PASSWORD=synq_dev_password
POSTGRES_DB=synq

RABBITMQ_DEFAULT_USER=synq
RABBITMQ_DEFAULT_PASS=synq_dev_password

# Bendras slaptas tokenas /internal/** kvietimams (X-Internal-Token)
INTERNAL_TOKEN=change-me-internal-token

# Gateway portas, kurį naudoja web ir iOS
GATEWAY_PORT=8080

# Cookie:Secure – false tik lokaliai per http
COOKIE_SECURE=false
